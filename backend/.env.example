# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000/api

# Image storage: local for development, cloudinary for persistent deployment storage
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myinner?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# PayPal (sandbox credentials from developer.paypal.com -- create an app,
# then a webhook subscribed to PAYMENT.CAPTURE.COMPLETED to get PAYPAL_WEBHOOK_ID)
PAYPAL_CLIENT_ID=sandbox_client_id_xxx
PAYPAL_CLIENT_SECRET=sandbox_client_secret_xxx
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=xxx
PAYPAL_RETURN_URL=http://localhost:5173/checkout/success
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel
PAYMENTS_MODE=paypal
PAYPAL_CHECKOUT_TIMEOUT_MINUTES=30

# Password reset email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=admin@my-inner.com
PASSWORD_RESET_URL=http://localhost:5173/reset-password
